{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"moduleResolution": "Node",
		// New in the Sliders fork: the same @sliders/* resolution vite.sliders-alias.js
		// does, so tsc and the editor agree with the bundler.
		"baseUrl": ".",
		"paths": {
			"@sliders/*": ["../twinejs-sliders/packages/*/src/index.ts"]
		},
		"strict": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
